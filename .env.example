# =============================================================================
# RiskAndCompliance — AI Security Analyst
# Copy to .env and fill in. NEVER commit .env.
# =============================================================================

# ---- LLM (one of these is required for reasoning; app degrades gracefully) ----
# OpenAI-compatible. Leave OPENAI_BASE_URL unset for api.openai.com.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Optional: Anthropic instead of OpenAI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- PRISM by Block Convey (MANDATORY sponsor tech for this hackathon) ----
# Create project at https://prism.blockconvey.com -> Settings -> Project
PRISMTRACE_HOST=https://prism.blockconvey.com
PRISMTRACE_PROJECT_ID=
PRISMTRACE_API_KEY=
PRISM_AGENT_ID=risk-and-compliance-analyst
PRISM_AGENT_NAME=RiskAndCompliance Security Analyst
# Set to false to disable trace emission locally
PRISM_ENABLED=true

# ---- ElevenLabs voice agent (bonus points: voice interaction) ----
# Agent ID from https://elevenlabs.io/app/agents
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# ---- Tavily (optional: sponsor credits, external framework/CVE lookups) ----
TAVILY_API_KEY=

# ---- Server ----
API_HOST=127.0.0.1
API_PORT=8787
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
