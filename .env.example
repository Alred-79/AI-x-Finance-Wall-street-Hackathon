# LLM via OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_AGENT=openai/gpt-5.6-terra
LLM_MODEL_FAST=openai/gpt-5.6-luna
LLM_MODEL_VISION=openai/gpt-5.6-terra

# ---- Offline / air-gapped inference (optional) -----------------------------------------
# Point at ANY OpenAI-compatible server and the whole analyst runs against it instead of
# OpenRouter. GIDE's local API (Ornith 1.0 9B) is the documented option: a tool that answers
# "will our data be touched by AI?" should be able to answer "no, nothing left the laptop".
#   GIDE   → start its local OpenAI-compatible server, then use its URL below
#   Ollama → LLM_BASE_URL=http://localhost:11434/v1  with LLM_MODEL_* set to a local tag
# Leave blank to use OpenRouter. When set, these override the OPENROUTER_* pair above.
LLM_BASE_URL=
LLM_API_KEY=

# ---- PRISM by Block Convey — agent observability ---------------------------------------
# Sign up at https://prism.blockconvey.com, then Settings -> Project for these two values.
# Absent credentials every trace is a silent no-op; the app runs exactly as before.
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
PRISMTRACE_HOST=https://prism.blockconvey.com
PRISM_AGENT_ID=ai-security-analyst
PRISM_AGENT_NAME=AI Security Analyst
PRISM_ENABLED=1

# Storage — leave DATABASE_URL empty for local SQLite; set a Neon/Postgres URL for pgvector
DATABASE_URL=
# Embeddings run locally (fastembed, CPU). EMBEDDING_PROVIDER=none disables dense retrieval.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# Index the datasets folder automatically on first start when the store is empty
AUTO_INDEX=1

# Web research
TAVILY_API_KEY=

# App
DATA_DIR=./data
DATASETS_DIR=./datasets
VENDOR_LEGAL_NAME=Solsphere AI Inc.
VENDOR_BRAND=Regodit
VENDOR_DOMAIN=regodit.com
